# Do not copy this by hand: `python -m app.cli init` writes .env with real secrets.
# The app refuses to start on a missing, short or placeholder value.

# 32+ random characters. Encrypts the API keys stored in the database.
SECRET_KEY=
# 32+ random characters. Signs sessions. Rotating it only signs you out.
JWT_SECRET_KEY=
# 32+ random characters. HKDF salt, random per install.
ENCRYPTION_SALT=

DATA_DIR=./data
HOST=127.0.0.1
PORT=8000
# Comma-separated addresses of proxies allowed to set X-Forwarded-For and -Proto. Empty
# means local use: only loopback host names are served, and the account is created in the
# browser. Set means a public site: the proxy picks the names, and the account is created
# with `python -m app.cli create-account`.
TRUSTED_PROXIES=
DEBUG=false
LOG_LEVEL=INFO
